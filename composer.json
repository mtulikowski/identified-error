{
    "name": "smartgroup/identified-error",
    "description": "Symfony bundle for correlating error pages with Monolog records using an error identifier.",
    "type": "symfony-bundle",
    "license": "MIT",
    "keywords": [
        "symfony",
        "bundle",
        "error",
        "monolog",
        "logging"
    ],
    "require": {
        "php": ">=8.2",
        "monolog/monolog": "^3.0",
        "symfony/framework-bundle": "^6.4 || ^7.0",
        "symfony/monolog-bundle": "^3.0",
        "symfony/twig-bundle": "^6.4 || ^7.0"
    },
    "autoload": {
        "psr-4": {
            "Smartgroup\\IdentifiedErrorBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Smartgroup\\IdentifiedErrorBundle\\Tests\\": "tests/"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5 || ^11.0",
        "symfony/phpunit-bridge": "^6.4 || ^7.0"
    },
    "scripts": {
        "test": "@php vendor/bin/phpunit"
    },
    "extra": {
        "symfony": {
            "allow-contrib": true
        }
    }
}
